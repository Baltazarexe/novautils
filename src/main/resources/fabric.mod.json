{
  "schemaVersion": 1,
  "id": "novautils",
  "name": "NovaUtils",
  "version": "${version}",
  "description": "Client-side utility mod: HUD, ESP, waypoints, fullbright, zoom and more. Configured entirely in-game.",
  "authors": [
    "you"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.novautils.NovaUtilsClient"
    ]
  },
  "depends": {
    "java": ">=${jdk_version}",
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*"
  }
}
